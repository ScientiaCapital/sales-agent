# =============================================================================
# VLM-AI-Core - Environment Configuration
# =============================================================================
# Scientia Capital Vision Language Model Services
# Copy this file to .env and fill in your values
# NEVER commit .env to git!
#
# CRITICAL: NO OPENAI KEYS - Use OpenRouter, Google, Anthropic only
# =============================================================================

# VLM Providers
# -----------------------------------------------------------------------------
# OpenRouter (PRIMARY - Qwen-VL, GLM-4V, Kimi-VL)
# Sign up: https://openrouter.ai/keys
# Cost: ~$0.00022 per call (Qwen3-30B)
OPENROUTER_API_KEY=

# Google Gemini (BALANCED - Gemini Pro Vision)
# Sign up: https://aistudio.google.com/apikey
# Cost: ~$0.0006 per call (Flash), $0.0100 (Pro)
GOOGLE_API_KEY=

# Anthropic Claude (EMERGENCY FALLBACK)
# Sign up: https://console.anthropic.com
# Cost: ~$0.0037 per call (Haiku), $0.0111 (Sonnet)
ANTHROPIC_API_KEY=

# LangSmith Observability (Optional)
# -----------------------------------------------------------------------------
# Sign up: https://smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=vlm-ai-core-dev
LANGCHAIN_TRACING_V2=true

# Database - Supabase (Optional)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Redis (Optional - for caching processed images)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Application Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development
